[
  {{- $pages := where .Site.RegularPages "Params.noindex" "!=" true -}}
  {{- range $index, $page := $pages -}}
    {{- if $index }},{{ end }}
    {{- $date := "" -}}
    {{- if not $page.Date.IsZero -}}
      {{- $date = $page.Date.Format "2006-01-02" -}}
    {{- end -}}
    {{- $metadata := dict "description" $page.Description "date" $date -}}
    {
      "title": {{ $page.Title | jsonify }},
      "url": {{ $page.RelPermalink | jsonify }},
      "description": {{ $page.Description | jsonify }},
      "date": {{ $date | jsonify }},
      "metadata": {{ $metadata | jsonify | jsonify }},
      "body": {{ $page.Plain | jsonify }}
    }
  {{- end -}}
]
